# Railway: reference the PostgreSQL service's DATABASE_URL on the application service.
DATABASE_URL=postgresql://tradedocs:tradedocs@127.0.0.1:5432/tradedocs
PORT=3000
NODE_ENV=development
# Enable only when your database requires TLS; verification remains enabled.
DATABASE_SSL=false
# Demo tracking is free and does not contact a carrier. Change to live when configured.
TRACKING_MODE=demo
# Optional live carrier tracking. Keep these on the backend only.
TRACKSHIP_API_KEY=
TRACKSHIP_APP_NAME=TradeDocs Navigator
