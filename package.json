{
  "name": "seng2021",
  "version": "1.0.0",
  "description": "TradeDocs Navigator: invoices, despatch advice and shipment tracking",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm --prefix frontend run build",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "ci-test": "npm test",
    "lint": "eslint src scripts tests",
    "check": "npm run lint && npm --prefix frontend run lint && npm --prefix frontend run build && npm run check:infra",
    "test:e2e": "playwright test",
    "check:infra": "node frontend/node_modules/typescript/bin/tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck .railway/railway.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "railway": "^3.13.1",
    "supertest": "^7.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.0.8",
    "helmet": "^8.1.0",
    "pg": "^8.14.1",
    "xsd-schema-validator": "^0.11.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22 <26"
  }
}
